aws_region   = "eu-central-1"
project_name = "cloud-shop"
environment  = "dev"

# EKS
cluster_version    = "1.29"
node_instance_type = "t3.medium"
node_desired_size  = 2
node_min_size      = 1
node_max_size      = 4

# RDS
db_name           = "cloudshop"
db_username       = "postgres"
db_password       = "CHANGE_ME_USE_SECRET"
db_instance_class = "db.t3.micro"
